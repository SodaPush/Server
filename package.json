{
  "name": "sodapush-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start:node": "tsx src/node.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply SODAPUSH_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply SODAPUSH_DB --remote",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@libsql/client": "^0.15.4",
    "hono": "^4.7.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250913.0",
    "typescript": "^5.8.3",
    "tsx": "^4.19.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.34.0"
  }
}
